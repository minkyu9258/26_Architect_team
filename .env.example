# ==== [1] LLM 설정 (Gemini 사용) ====
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=""
LLM_ROLE_INTENT_MODEL=gemini-2.5-flash
LLM_ROLE_PLANNER_MODEL=gemini-2.5-pro
LLM_ROLE_SUMMARY_MODEL=gemini-2.5-flash
LLM_HTTP_TIMEOUT=20
LLM_HTTP_MAX_RETRIES=0
LLM_BYPASS_PROXY=true

# ==== [2] 임베딩 설정 (Gemini 사용) ====
EMBEDDING_PROVIDER=openai
EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBED_API_KEY=""
EMBED_MODEL_NAME=gemini-embedding-2
EMBEDDING_DIM=768

# ==== [3] 데이터베이스 및 RAG 설정 ====
VECTOR_STORE_PROVIDER=pgvector
VECTOR_DB_DSN=postgresql://postgres:postgres@vector-db:5432/mdm
RAG_ENABLED=true
RAG_TOP_K=4
RAG_MIN_SCORE=0.35
RAG_AUTO_INGEST=true
RAG_INGEST_CHUNK_SIZE=900
RAG_INGEST_CHUNK_OVERLAP=120
REDIS_URL=redis://redis:6379/0
RAG_CACHE_TTL_SEC=600